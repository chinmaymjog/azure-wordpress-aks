#!/bin/bash

set -e  # Exit immediately if a command exits with a non-zero status
set -u  # Treat unset variables as an error
set -o pipefail  # Catch errors in pipelines

# Function for error handling
die () {
    echo "Error: $1" >&2
    exit 1
}

# Function for script usage
usage () {
    echo "Usage: $0 --host <host> --admin <admin> --password <admin_pass> --dbname <db_name> --staccount <st_account> --stkey <st_key> --stcontainer <st_container> --path <path>"
    exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --host) DB_HOST="$2"; shift 2;;
        --admin) DB_ADMIN="$2"; shift 2;;
        --password) DB_PASS="$2"; shift 2;;
        --dbname) DB_NAME="$2"; shift 2;;
        --staccount) ST_ACCOUNT="$2"; shift 2;;
        --stkey) ST_KEY="$2"; shift 2;;
        --stcontainer) ST_CONTAINER="$2"; shift 2;;
        --path) DIR="$2"; shift 2;;
        --help) usage;;
        *) die "Unknown option: $1";;
    esac
done

# Validate required parameters
if [[ -z "${DB_HOST:-}" || -z "${DB_ADMIN:-}" || -z "${DB_PASS:-}" || -z "${DB_NAME:-}" || -z "${ST_ACCOUNT:-}" || -z "${ST_KEY:-}" || -z "${ST_CONTAINER:-}" || -z "${DIR:-}" ]]; then
    die "Missing required parameters."
fi

# DB_NAME is interpolated into SQL; restrict it to safe identifier characters.
if [[ ! "$DB_NAME" =~ ^[A-Za-z0-9_$-]+$ ]]; then
    die "Invalid database name '$DB_NAME' (allowed: letters, digits, _, $, -)."
fi

# Pass the password via the environment so it is not visible in the process list.
export MYSQL_PWD="$DB_PASS"

# Keep the plaintext dump, archive and checkin file in a private directory
# that is removed on exit, including on failure.
WORKDIR=$(mktemp -d) || die "Failed to create a temporary directory."
trap 'rm -rf "$WORKDIR"' EXIT

# Set Azure storage environment variables
export AZURE_STORAGE_ACCOUNT="$ST_ACCOUNT"
export AZURE_STORAGE_KEY="$ST_KEY"

# Check if Directory exists
echo "===> Checking if Directory '$DIR' exists..."
if az storage fs directory exists --file-system "$ST_CONTAINER" --name "$DIR" -o tsv | grep -q "True"; then
    echo "===> Directory '$DIR' exists."
else
    die "Directory '$DIR' does not exists."
fi  

echo "===> Checking if database '$DB_NAME' exists on host '$DB_HOST'."
DB_EXISTS=$(mysql -h "$DB_HOST" -u"$DB_ADMIN" --skip-column-names -e "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$DB_NAME';") || die "Failed to connect to MySQL."

if [[ "$DB_EXISTS" == "$DB_NAME" ]]; then
    TIMESTAMP=$(date -u +%Y%m%dT%H%M%SZ)
    BACKUP_FILE="$DB_NAME-$TIMESTAMP.sql"

    echo "===> Creating database dump for '$DB_NAME'."
    mysqldump -h "$DB_HOST" -u"$DB_ADMIN" --routines --single-transaction --quick "$DB_NAME" > "$WORKDIR/$BACKUP_FILE" || die "Database dump failed."

    # Verify the dump file exists before proceeding
    if [[ ! -f "$WORKDIR/$BACKUP_FILE" ]]; then
        die "Backup file '$BACKUP_FILE' not found!"
    fi

    echo "===> Database dump created: $BACKUP_FILE. Compressing the backup file."
    tar -czf "$WORKDIR/$BACKUP_FILE.tar.gz" -C "$WORKDIR" "$BACKUP_FILE" || die "Compressing the backup failed."
    echo "$BACKUP_FILE" > "$WORKDIR/checkin.txt"

    echo "===> Uploading database backup to Azure Blob Storage."
    az storage blob upload --container-name "$ST_CONTAINER" --file "$WORKDIR/$BACKUP_FILE.tar.gz" --name "$DIR/$BACKUP_FILE.tar.gz" --overwrite || die "Backup upload failed."
    echo "===> Checkin file upload to Azure Blob Storage."
    az storage blob upload --container-name "$ST_CONTAINER" --file "$WORKDIR/checkin.txt" --name "$DIR/checkin.txt" --overwrite || die "Checkin file upload failed."
    echo "===> Database backup '$BACKUP_FILE' uploaded successfully."
else
    echo "===> Database '$DB_NAME' does not exist. Skipping backup."
fi
